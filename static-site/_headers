# Netlify Cache Headers — Finesse Media Optimized
# Generated by Mario Speed Optimizer

# Bundled CSS/JS — immutable (hash in filename)
/bundle.*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8

/bundle.*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# Images — long cache
/images/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=2592000

# Fonts (Google serves its own, but just in case)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — short cache, always revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Favicon
/favicon.ico
  Cache-Control: public, max-age=604800

# Security headers for all paths
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
